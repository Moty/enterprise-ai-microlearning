# LLM Providers
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Voice Engine (ElevenLabs)
ELEVENLABS_API_KEY=

# Avatar & Lip-Sync
HEDRA_API_KEY=
HEYGEN_API_KEY=

# LinkedIn Integration
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_URN_HERE

# Output & Asset Paths
OUTPUT_DIR=./output
ASSETS_DIR=./assets

# Storage Backend ('local' for offline JSON manifests, 'firestore' for cloud dashboard/workers)
STORAGE_BACKEND=local
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_JOBS=microlearning_jobs
