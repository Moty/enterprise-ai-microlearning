rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Microlearning jobs collection: readable for review dashboard, write allowed for SME review/approval
    match /microlearning_jobs/{jobId} {
      allow read, write: if true;
    }
    // Analytics telemetry collection
    match /analytics_telemetry/{docId} {
      allow read, write: if true;
    }

  }
}

