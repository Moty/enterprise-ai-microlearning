rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Microlearning jobs collection: readable for review dashboard, write requires authentication
    match /microlearning_jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Analytics telemetry collection
    match /analytics_telemetry/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

